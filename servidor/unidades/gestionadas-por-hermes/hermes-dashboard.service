[Unit]
Description=Hermes Agent Dashboard (solo 127.0.0.1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart="/home/servidor/.hermes/hermes-agent/.hermes/bin/hermes" "dashboard" "--no-open"
WorkingDirectory=/home/servidor/.hermes
Environment="PATH=/home/servidor/.hermes/hermes-agent/node_modules/.bin:/home/servidor/.hermes/tools/node-26.7.0-linux-x64/bin:/home/servidor/.hermes/tools/npm-12.0.2-linux-x64/bin:/home/servidor/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HERMES_HOME=/home/servidor/.hermes"
Restart=always
RestartSec=10
# 78 = negativa deliberada (ya hay otro dashboard en marcha); no reintentar en bucle
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
